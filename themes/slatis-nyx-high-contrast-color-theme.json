    "property": "#f0f3f6",
    "property.readonly": "#f0f3f6",
    "event": "#f0f3f6",
    "enumMember": "#91cbff",
    "keyword": "#ff9492",
    "modifier": "#ff9492",
    "operator": "#ff9492",
    "selfParameter": "#91cbff",
    "string": "#addcff",
    "number": "#91cbff",
    "regexp": "#caeaff",
    "label": "#ffb757",
    "comment": {
      "foreground": "#9ea7b3",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.abstract": {
      "italic": true
    },
    "type.declaration": {
      "bold": true
    },
    "class.declaration": {
      "bold": true
    },
    "function.declaration": {
      "bold": true
    },
    "method.declaration": {
      "bold": true
    },
    "*.readonly": {
      "bold": true
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#9ea7b3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constants, language variables, support",
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language",
        "support",
        "support.constant",
        "support.variable",
        "support.type.property-name.json",
        "meta.property-name",
        "meta.module-reference",
        "string variable"
      ],
      "settings": {
        "foreground": "#91cbff"
      }
    },
    {
      "name": "Entities — functions, classes, types",
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#cb9eff"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter.function",
        "meta.function-call.arguments"
      ],
      "settings": {
        "foreground": "#f0f3f6"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#72f088"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ff9492"
      }
    },
    {
      "name": "Package and import modifiers stay neutral",
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#f0f3f6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.section.embedded source",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#addcff"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "source.regexp",
        "string.regexp",
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": {
        "foreground": "#caeaff"
      }
    },
    {
      "name": "Regex escapes",
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "foreground": "#72f088"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffb757"
      }
    },
    {
      "name": "Plain variables, embedded, object keys",
      "scope": [
        "variable.other",
        "meta.embedded",
        "meta.template.expression",
        "meta.jsx.children",
        "meta.object-literal.key",
        "string source",
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#f0f3f6"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.broken",
        "invalid.deprecated",
        "invalid.illegal",
        "invalid.unimplemented",
        "message.error"
      ],
      "settings": {
        "foreground": "#ffc9c7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup — headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#91cbff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup — quotes and lists",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#72f088",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup — list bullets",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#ffb757"
      }
    },
    {
      "name": "Markup — raw and links",
      "scope": [
        "markup.raw",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#91cbff"
      }
    },
    {
      "name": "Markup — links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#caeaff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup — emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f0f3f6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#f0f3f6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Diff — deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#ffc9c7",
        "background": "#cc1421"
      }
    },
    {
      "name": "Diff — inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#72f088",
        "background": "#007728"
      }
    },
    {
      "name": "Diff — changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#ffb757",
        "background": "#a74c00"
      }
    },
    {
      "name": "Diff — ignored",
      "scope": [
        "markup.ignored",
        "markup.untracked"
      ],
      "settings": {
        "foreground": "#21262d",
        "background": "#91cbff"
      }
    },
    {
      "name": "Meta separators",
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#91cbff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Terminal tokens",
      "scope": [
        "meta.output"
      ],
      "settings": {
        "foreground": "#91cbff"
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#91cbff"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#ffb757"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#ffc9c7"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#cb9eff"
      }
    }
  ]
}
