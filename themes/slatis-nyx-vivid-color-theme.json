  "semanticTokenColors": {
    "namespace": "#79c0ff",
    "class": "#79c0ff",
    "interface": "#79c0ff",
    "struct": "#79c0ff",
    "enum": "#79c0ff",
    "type": "#79c0ff",
    "typeParameter": "#79c0ff",
    "class.defaultLibrary": "#79c0ff",
    "interface.defaultLibrary": "#79c0ff",
    "function": "#d2a8ff",
    "method": "#d2a8ff",
    "decorator": "#d2a8ff",
    "macro": "#d2a8ff",
    "function.defaultLibrary": "#d2a8ff",
    "method.defaultLibrary": "#d2a8ff",
    "parameter": "#e6edf3",
    "variable": "#e6edf3",
    "variable.readonly": "#79c0ff",
    "variable.readonly.defaultLibrary": "#79c0ff",
    "variable.defaultLibrary": "#79c0ff",
    "property": "#e6edf3",
    "property.readonly": "#e6edf3",
    "event": "#e6edf3",
    "enumMember": "#79c0ff",
    "keyword": "#ff7b72",
    "modifier": "#ff7b72",
    "operator": "#ff7b72",
    "selfParameter": "#79c0ff",
    "string": "#a5d6ff",
    "number": "#79c0ff",
    "regexp": "#cae8ff",
    "label": "#ffa657",
    "comment": {
      "foreground": "#8b949e",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.abstract": {
      "italic": true
    },
    "type.declaration": {
      "bold": true
    },
    "class.declaration": {
      "bold": true
    },
    "function.declaration": {
      "bold": true
    },
    "method.declaration": {
      "bold": true
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8b949e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constants, language variables, support",
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language",
        "support",
        "support.constant",
        "support.variable",
        "support.type.property-name.json",
        "meta.property-name",
        "meta.module-reference",
        "string variable"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Entities — functions, classes, types",
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#d2a8ff"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter.function",
        "meta.function-call.arguments"
      ],
      "settings": {
        "foreground": "#e6edf3"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#7ee787"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Package and import modifiers stay neutral",
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#e6edf3"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.section.embedded source",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#a5d6ff"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "source.regexp",
        "string.regexp",
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": {
        "foreground": "#cae8ff"
      }
    },
    {
      "name": "Regex escapes",
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "foreground": "#7ee787"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "Plain variables, embedded, object keys",
      "scope": [
        "variable.other",
        "meta.embedded",
        "meta.template.expression",
        "meta.jsx.children",
        "meta.object-literal.key",
        "string source",
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#e6edf3"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.broken",
        "invalid.deprecated",
        "invalid.illegal",
        "invalid.unimplemented",
        "message.error"
      ],
      "settings": {
        "foreground": "#ffa198",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup — headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#79c0ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup — quotes and lists",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#7ee787",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup — list bullets",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "Markup — raw and links",
      "scope": [
        "markup.raw",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Markup — links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#cae8ff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup — emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e6edf3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e6edf3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Diff — deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#ffa198",
        "background": "#67060c"
      }
    },
    {
      "name": "Diff — inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#7ee787",
        "background": "#033a16"
      }
    },
    {
      "name": "Diff — changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#ffa657",
        "background": "#5a1e02"
      }
    },
    {
      "name": "Diff — ignored",
      "scope": [
        "markup.ignored",
        "markup.untracked"
      ],
      "settings": {
        "foreground": "#161b22",
        "background": "#79c0ff"
      }
    },
    {
      "name": "Meta separators",
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#79c0ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Terminal tokens",
      "scope": [
        "meta.output"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#ffa198"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#d2a8ff"
      }
    }
  ]
}
