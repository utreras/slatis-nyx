    },
    "type.declaration": {
      "bold": true
    },
    "class.declaration": {
      "bold": true
    },
    "function.declaration": {
      "bold": true
    },
    "method.declaration": {
      "bold": true
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#768390",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constants, language variables, support",
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language",
        "support",
        "support.constant",
        "support.variable",
        "support.type.property-name.json",
        "meta.property-name",
        "meta.module-reference",
        "string variable"
      ],
      "settings": {
        "foreground": "#6cb6ff"
      }
    },
    {
      "name": "Entities — functions, classes, types",
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#dcbdfb"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter.function",
        "meta.function-call.arguments"
      ],
      "settings": {
        "foreground": "#adbac7"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#8ddb8c"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#f47067"
      }
    },
    {
      "name": "Package and import modifiers stay neutral",
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#adbac7"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.section.embedded source",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#96d0ff"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "source.regexp",
        "string.regexp",
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": {
        "foreground": "#c6e6ff"
      }
    },
    {
      "name": "Regex escapes",
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "foreground": "#8ddb8c"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#f69d50"
      }
    },
    {
      "name": "Plain variables, embedded, object keys",
      "scope": [
        "variable.other",
        "meta.embedded",
        "meta.template.expression",
        "meta.jsx.children",
        "meta.object-literal.key",
        "string source",
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#adbac7"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.broken",
        "invalid.deprecated",
        "invalid.illegal",
        "invalid.unimplemented",
        "message.error"
      ],
      "settings": {
        "foreground": "#ff938a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup — headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#6cb6ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup — quotes and lists",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8ddb8c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup — list bullets",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#f69d50"
      }
    },
    {
      "name": "Markup — raw and links",
      "scope": [
        "markup.raw",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#6cb6ff"
      }
    },
    {
      "name": "Markup — links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#c6e6ff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup — emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#adbac7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#adbac7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Diff — deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#ff938a",
        "background": "#78191b"
      }
    },
    {
      "name": "Diff — inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#8ddb8c",
        "background": "#1b4721"
      }
    },
    {
      "name": "Diff — changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#f69d50",
        "background": "#682d0f"
      }
    },
    {
      "name": "Diff — ignored",
      "scope": [
        "markup.ignored",
        "markup.untracked"
      ],
      "settings": {
        "foreground": "#22272e",
        "background": "#6cb6ff"
      }
    },
    {
      "name": "Meta separators",
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#6cb6ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Terminal tokens",
      "scope": [
        "meta.output"
      ],
      "settings": {
        "foreground": "#6cb6ff"
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#6cb6ff"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#f69d50"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#ff938a"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#dcbdfb"
      }
    }
  ]
}
