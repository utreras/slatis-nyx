  // Semantic tokens run first and win over TextMate scopes.
  // This is the layer Black Material never enabled.
  "semanticTokenColors": {
    "namespace": "#f2c86c",
    "class": "#f2c86c",
    "interface": "#f2c86c",
    "struct": "#f2c86c",
    "enum": "#f2c86c",
    "type": "#f2c86c",
    "typeParameter": "#f2c86c",
    "class.defaultLibrary": "#f2c86c",
    "interface.defaultLibrary": "#f2c86c",

    "function": "#c9a3f0",
    "method": "#c9a3f0",
    "decorator": "#c9a3f0",
    "function.defaultLibrary": "#c9a3f0",
    "method.defaultLibrary": "#c9a3f0",

    "parameter": "#cdcecd",
    "variable": "#cdcecd",
    "variable.readonly": "#cdcecd",
    "variable.readonly.defaultLibrary": "#ff9e96",
    "variable.defaultLibrary": "#ff9e96",

    "property": "#e97871",
    "property.readonly": "#e97871",
    "enumMember": "#ff9e96",
    "event": "#e97871",

    "keyword": "#91dbf2",
    "modifier": "#91dbf2",
    "string": "#b4de89",
    "number": "#f98b6f",
    "regexp": "#b4de89",
    "operator": "#8e8f8f",
    "comment": { "foreground": "#626463", "fontStyle": "italic" },
    "label": "#a2c4d0",
    "macro": "#c9a3f0",
    "selfParameter": "#91dbf2",

    "*.deprecated": { "strikethrough": true },
    "*.abstract": { "italic": true },

    "type.declaration": { "bold": true },
    "class.declaration": { "bold": true },
    "function.declaration": { "bold": true },
    "method.declaration": { "bold": true }
  },

  "tokenColors": [
    {
      "name": "Base / variables / embedded",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.language",
        "constant.character.escape",
        "source.groovy.embedded",
        "source.cs entity.name.type.namespace",
        "source.cpp meta.block variable.other",
        "source.php support.other.namespace",
        "source.php meta.use support.class",
        "text.html constant.character.entity.named",
        "meta.embedded",
        "meta.template.expression",
        "meta.definition.variable entity.name.function",
        "meta.function-call.arguments",
        "meta.jsx.children",
        "support.variable",
        "support.constant",
        "punctuation.definition.entity.html"
      ],
      "settings": { "foreground": "#cdcecd" }
    },

    {
      "name": "Punctuation — demoted to neutral",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.parameters",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "template.expression.begin",
        "template.expression.end",
        "meta.brace",
        "meta.tag"
      ],
      "settings": { "foreground": "#8e8f8f" }
    },

    {
      "name": "Fenced code",
      "scope": ["markup.fenced_code.block"],
      "settings": { "foreground": "#8e8f8f" }
    },

    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment punctuation.definition.comment",
        "string.quoted.docstring",
        "source.cs meta.preprocessor"
      ],
      "settings": { "foreground": "#626463" }
    },

    {
      "name": "Tags / object keys / properties",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.yaml",
        "text.html.markdown meta.link.inline",
        "markup.deleted",
        "markup.italic",
        "markup.bold",
        "keyword.other.definition.ini",
        "source.cs meta.method.identifier entity.name.function",
        "source.python meta.member.access.python",
        "variable.object.property",
        "support.module",
        "support.node",
        "support.type.property-name.json",
        "meta.field.declaration entity.name.function",
        "meta.link.reference",
        "meta.block",
        "meta.object-literal.key",
        "meta.object-literal.key string",
        "meta.definition.method entity.name.function"
      ],
      "settings": { "foreground": "#e97871" }
    },

    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "keyword.other",
        "entity.other.attribute-name.id"
      ],
      "settings": { "foreground": "#f98b6f" }
    },

    {
      "name": "Booleans / enum members",
      "scope": [
        "constant.language.boolean",
        "punctuation.definition.quote"
      ],
      "settings": { "foreground": "#ff9e96" }
    },

    {
      "name": "Types / classes",
      "scope": [
        "source.cs meta.class.identifier storage.type",
        "source.cs storage.type",
        "source.cs meta.method.return-type",
        "entity.name.type",
        "entity.other.inherited-class",
        "entity.other",
        "entity.name",
        "entity.name.type.class",
        "entity.other.attribute-name.class",
        "support.type",
        "support.class",
        "support.class.component",
        "constant.other.key",
        "meta.use"
      ],
      "settings": { "foreground": "#f2c86c" }
    },

    {
      "name": "Keywords / storage / control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "modifier",
        "storage",
        "storage.type",
        "storage.control",
        "storage.modifier",
        "markup.heading",
        "markup.quote",
        "text.html.markdown beginning.punctuation.definition.list",
        "entity.name.section.group-title.ini",
        "variable.language.this",
        "support.type.object",
        "constant.keyword",
        "constant.other.symbol",
        "constant.language",
        "constant.language.json"
      ],
      "settings": { "foreground": "#91dbf2" }
    },

    {
      "name": "Property names — CSS props and markup attributes share one role",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "meta.tag entity.other.attribute-name"
      ],
      "settings": { "foreground": "#a2c4d0" }
    },

    {
      "name": "Strings",
      "scope": [
        "string",
        "markup.fenced_code.block.markdown punctuation.definition.markdown",
        "markup.inline.raw.string.markdown",
        "markup.inserted"
      ],
      "settings": { "foreground": "#b4de89" }
    },

    {
      "name": "Functions",
      "scope": [
        "entity.name.function.call",
        "entity.name.function",
        "meta.function entity.name.function",
        "support.function",
        "meta.decorator",
        "source.cs meta.method-call meta.method, source.cs entity.name.function",
        "source.python meta.function-call.python, meta.function-call.arguments"
      ],
      "settings": { "foreground": "#c9a3f0" }
    },

    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#8e8f8f" }
    },

    {
      "scope": [
        "markup.italic",
        "support.module",
        "support.node",
        "comment",
        "comment punctuation.definition.comment",
        "string.quoted.docstring",
        "keyword.control",
        "markup.quote"
      ],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
      "settings": { "fontStyle": "italic bold" }
    },
    {
      "scope": ["markup.underline"],
      "settings": { "fontStyle": "underline" }
    },

    { "scope": "token.info-token", "settings": { "foreground": "#4589ff" } },
    { "scope": "token.warn-token", "settings": { "foreground": "#f1c21b" } },
    { "scope": "token.error-token", "settings": { "foreground": "#fa4d56" } },
    { "scope": "token.debug-token", "settings": { "foreground": "#c9a3f0" } }
  ]
}
