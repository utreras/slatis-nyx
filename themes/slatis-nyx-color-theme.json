// Slatis Nyx — palette contract
//
// SURFACES
// bg-0   #000000  chrome (activity bar, sidebar, tabs, status bar)
// bg-1   #0b0b0b  editor canvas
// bg-2   #151616  raised (widgets, inputs, hover cards)
// bg-3   #202221  raised+
// bg-4   #2c2e2d  border-subtle   <- was the old border-invisible
// bg-5   #383a39  border-strong
//
// TEXT
// base       #cdcecd
// secondary  #8e8f8f
// tertiary   #626463
// disabled   #2c2e2d
//
// ACCENT — IBM Carbon Blue
// blue-30  #a6c8ff  hover text
// blue-40  #78a9ff  links, bright accent            (8.4:1)
// blue-50  #4589ff  PRIMARY UI accent                (5.9:1)
// blue-60  #0f62fe  fills only, white text on top    (3.9:1)
//
// STATUS
// red-50    #fa4d56  badges, errors, deletions
// green-50  #42be65  additions, success
// yellow-50 #f1c21b  warnings
// orange-50 #ff832b  conflicts
//
// CODE — blue is reserved for chrome, never for syntax
// tag/property   #e97871
// boolean        #ff9e96
// number         #f98b6f
// type/class     #f2c86c
// string         #b4de89
// attr/css-prop  #a2c4d0
// keyword        #91dbf2
// function       #c9a3f0
// punctuation    #8e8f8f  (demoted to neutral — GitHub behaviour)

