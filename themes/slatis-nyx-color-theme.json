    "commandCenter.inactiveForeground": "#4a4c4b",
    "commandCenter.inactiveBorder": "#202221",
    "commandCenter.debuggingBackground": "#0f62fe30",

    // ---- Window frame (needs window.titleBarStyle: custom) ----
    "window.activeBorder": "#383a39",
    "window.inactiveBorder": "#202221",

    // ---- Activity bar: tinted slab on the active item, not just a hairline ----
    "activityBar.activeBackground": "#4589ff14",
    "activityBar.activeFocusBorder": "#4589ff",
    "activityBar.dropBorder": "#4589ff",
    "activityBarTop.background": "#000000",
    "activityBarTop.foreground": "#cdcecd",
    "activityBarTop.inactiveForeground": "#4a4c4b",
    "activityBarTop.activeBorder": "#4589ff",
    "activityBarTop.activeBackground": "#4589ff14",
    "activityBarTop.dropBorder": "#4589ff",
    "sideBarActivityBarTop.border": "#2c2e2d",

    // Split badges: generic counters (git changes, extensions) are blue,
    // errors are red, warnings yellow. Separate keys, verified in 1.136.
    "activityErrorBadge.background": "#fa4d56",
    "activityErrorBadge.foreground": "#ffffff",
