    "terminal.ansiBlack": "#2c2e2d",
    "terminal.ansiBrightBlack": "#626463",
    "terminal.ansiRed": "#e97871",
    "terminal.ansiBrightRed": "#ff9e96",
    "terminal.ansiGreen": "#42be65",
    "terminal.ansiBrightGreen": "#6fdc8c",
    "terminal.ansiYellow": "#f2c86c",
    "terminal.ansiBrightYellow": "#f1c21b",
    "terminal.ansiBlue": "#4589ff",
    "terminal.ansiBrightBlue": "#78a9ff",
    "terminal.ansiMagenta": "#c9a3f0",
    "terminal.ansiBrightMagenta": "#d8bcf7",
    "terminal.ansiCyan": "#5ec8e5",
    "terminal.ansiBrightCyan": "#91dbf2",
    "terminal.ansiWhite": "#cdcecd",
    "terminal.ansiBrightWhite": "#ffffff"
  },


  // GitHub's role taxonomy, one improvement on top: GitHub paints functions and
  // types with the same purple (both match entity.name). Splitting types onto
  // the support-blue keeps the distinction the language server already knows.
  "semanticTokenColors": {
    "namespace": "#79b8ff",
    "class": "#79b8ff",
    "interface": "#79b8ff",
    "struct": "#79b8ff",
    "enum": "#79b8ff",
    "type": "#79b8ff",
    "typeParameter": "#79b8ff",
    "class.defaultLibrary": "#79b8ff",
    "interface.defaultLibrary": "#79b8ff",

    "function": "#b392f0",
    "method": "#b392f0",
    "decorator": "#b392f0",
    "macro": "#b392f0",
    "function.defaultLibrary": "#b392f0",
    "method.defaultLibrary": "#b392f0",

    "parameter": "#e1e4e8",
    "variable": "#e1e4e8",
    "variable.readonly": "#79b8ff",
    "variable.readonly.defaultLibrary": "#79b8ff",
    "variable.defaultLibrary": "#79b8ff",

    // Object literal keys are the most frequent token in config-shaped TS.
    // Blue here stops reading as an accent and becomes the page colour, which
    // is why GitHub leaves them at the base foreground.
    "property": "#e1e4e8",
    "property.readonly": "#e1e4e8",
    "event": "#e1e4e8",
    "enumMember": "#79b8ff",

    "keyword": "#f97583",
    "modifier": "#f97583",
    "operator": "#f97583",
    "selfParameter": "#79b8ff",
    "string": "#9ecbff",
    "number": "#79b8ff",
    "regexp": "#dbedff",
    "label": "#ffab70",
    "comment": { "foreground": "#6a737d", "fontStyle": "italic" },

    "*.deprecated": { "strikethrough": true },
    "*.abstract": { "italic": true },

    "type.declaration": { "bold": true },
    "class.declaration": { "bold": true },
    "function.declaration": { "bold": true },
    "method.declaration": { "bold": true }
  },

  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#6a737d", "fontStyle": "italic" }
    },
    {
      "name": "Constants, language variables, support",
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language",
        "support",
        "support.constant",
        "support.variable",
        "support.type.property-name.json",
        "meta.property-name",
        "meta.module-reference",
        "string variable"
      ],
      "settings": { "foreground": "#79b8ff" }
    },
    {
      "name": "Entities — functions, classes, types",
      "scope": ["entity", "entity.name"],
      "settings": { "foreground": "#b392f0" }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter.function", "meta.function-call.arguments"],
      "settings": { "foreground": "#e1e4e8" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "entity.name.tag.yaml"],
      "settings": { "foreground": "#85e89d" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.operator"],
      "settings": { "foreground": "#f97583" }
    },
    {
      "name": "Package and import modifiers stay neutral",
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": { "foreground": "#e1e4e8" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.section.embedded source",
        "markup.inline.raw.string.markdown"
      ],
      "settings": { "foreground": "#9ecbff" }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "source.regexp",
        "string.regexp",
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": { "foreground": "#dbedff" }
    },
    {
      "name": "Regex escapes",
      "scope": "string.regexp constant.character.escape",
      "settings": { "foreground": "#85e89d" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "entity.other.attribute-name"],
      "settings": { "foreground": "#ffab70" }
    },
    {
      "name": "Plain variables, embedded, object keys",
      "scope": [
        "variable.other",
        "meta.embedded",
        "meta.template.expression",
        "meta.jsx.children",
        "meta.object-literal.key",
        "string source",
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": { "foreground": "#e1e4e8" }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.broken",
        "invalid.deprecated",
        "invalid.illegal",
        "invalid.unimplemented",
        "message.error"
      ],
      "settings": { "foreground": "#fdaeb7", "fontStyle": "italic" }
    },
    {
      "name": "Markup — headings",
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#79b8ff", "fontStyle": "bold" }
    },
    {
      "name": "Markup — quotes and lists",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#85e89d", "fontStyle": "italic" }
    },
    {
      "name": "Markup — list bullets",
      "scope": ["punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#ffab70" }
    },
    {
      "name": "Markup — raw and links",
      "scope": ["markup.raw", "markup.inline.raw"],
      "settings": { "foreground": "#79b8ff" }
    },
    {
      "name": "Markup — links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#dbedff", "fontStyle": "underline" }
    },
    {
      "name": "Markup — emphasis",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#e1e4e8", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#e1e4e8", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
      "settings": { "fontStyle": "italic bold" }
    },
    {
      "name": "Diff — deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
      "settings": { "foreground": "#fdaeb7", "background": "#86181d" }
    },
    {
      "name": "Diff — inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
      "settings": { "foreground": "#85e89d", "background": "#144620" }
    },
    {
      "name": "Diff — changed",
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": { "foreground": "#ffab70", "background": "#c24e00" }
    },
    {
      "name": "Diff — ignored",
      "scope": ["markup.ignored", "markup.untracked"],
      "settings": { "foreground": "#2f363d", "background": "#79b8ff" }
    },
    {
      "name": "Meta separators",
      "scope": ["meta.separator"],
      "settings": { "foreground": "#79b8ff", "fontStyle": "bold" }
    },
    {
      "name": "Terminal tokens",
      "scope": ["meta.output"],
      "settings": { "foreground": "#79b8ff" }
    },
    { "scope": "token.info-token", "settings": { "foreground": "#79b8ff" } },
    { "scope": "token.warn-token", "settings": { "foreground": "#ffab70" } },
    { "scope": "token.error-token", "settings": { "foreground": "#fdaeb7" } },
    { "scope": "token.debug-token", "settings": { "foreground": "#b392f0" } }
  ]
}
